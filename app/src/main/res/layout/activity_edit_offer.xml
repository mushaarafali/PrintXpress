<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Offer"
            android:textColor="@color/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="45dp" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginTop="22dp">
            <EditText
                android:id="@+id/editOfferTitle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="Offer Title"
                android:textColor="@color/text_main"
                android:background="@android:color/transparent"
                android:padding="14dp" />
        </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:layout_marginTop="14dp">
            <EditText
                android:id="@+id/editOfferDescription"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="Offer Description"
                android:textColor="@color/text_main"
                android:background="@android:color/transparent"
                android:gravity="top"
                android:padding="14dp" />
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/updateOfferBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Update Offer"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:cornerRadius="27dp" />

    </LinearLayout>
</ScrollView>