<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/customerWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome Back!"
            android:textColor="@color/colorPrimary"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="30dp" />

        <!-- Quick Actions -->
        <Button
            android:id="@+id/btnProducts"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Browse Products"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:layout_marginBottom="15dp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnMyOrders"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="View My Orders"
            android:backgroundTint="@color/colorSecondary"
            android:textColor="@color/white"
            android:layout_marginBottom="15dp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnOffers"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Special Offers"
            android:textColor="@color/colorPrimary"
            app:strokeColor="@color/colorPrimary"
            android:layout_marginBottom="15dp"
            app:cornerRadius="12dp" />

        <Button
            android:id="@+id/btnGuidelines"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Help &amp; Support / Guidelines"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="30dp" />

        <Button
            android:id="@+id/customerLogoutBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Logout"
            android:backgroundTint="#dc2626"
            android:textColor="@color/white"
            app:cornerRadius="27dp" />

    </LinearLayout>
</ScrollView>