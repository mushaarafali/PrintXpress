<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_premium_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adminWelcome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Admin Dashboard"
            android:textColor="@color/colorPrimary"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginTop="45dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Main Management"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnManageOrders"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:text="Manage Bookings / Orders"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="10dp"
            app:cornerRadius="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quick Actions"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:layout_marginTop="30dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnAddProduct"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Add\nProduct"
                android:backgroundTint="@color/premium_blue_dark"
                android:textColor="@color/white"
                android:layout_marginEnd="5dp"
                app:cornerRadius="12dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnManageProducts"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Manage\nProducts"
                android:backgroundTint="@color/premium_blue_dark"
                android:textColor="@color/white"
                android:layout_marginStart="5dp"
                app:cornerRadius="12dp"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <Button
                android:id="@+id/btnManageOffers"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Manage\nOffers"
                android:backgroundTint="@color/premium_blue_dark"
                android:textColor="@color/white"
                android:layout_marginEnd="5dp"
                app:cornerRadius="12dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnManageUsers"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="View\nUsers"
                android:backgroundTint="@color/premium_blue_dark"
                android:textColor="@color/white"
                android:layout_marginStart="5dp"
                app:cornerRadius="12dp"
                android:textSize="12sp" />
        </LinearLayout>

        <Button
            android:id="@+id/adminLogoutBtn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Logout"
            android:backgroundTint="#dc2626"
            android:textColor="@color/white"
            android:layout_marginTop="40dp"
            app:cornerRadius="27dp" />

    </LinearLayout>
</ScrollView>